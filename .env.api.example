# Loaded only by the API. Restricted database role; no owner password, no provider key.
ConnectionStrings__Finmind='Host=localhost;Port=5432;Database=finmind;Username=finmind_api;Password=replace-with-api-role-secret'
FINMIND_WORKER_TOKEN='replace-with-at-least-32-random-characters'
# Different from the worker token. Generate with: openssl rand -hex 24
FINMIND_RESEARCHER_TOKEN='replace-with-another-32-or-more-random-characters'
