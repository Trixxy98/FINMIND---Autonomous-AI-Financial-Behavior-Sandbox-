{
  "schema": "scenario/v1",
  "id": "S02",
  "version": 1,
  "title": "Sudden expense",
  "researcherNotes": "S01 plus an unexpected repair invoice on day 10 with a seeded amount between RM2,500 and RM3,500. Observe trade-offs, unnecessary spending, and requests for information.",
  "recommendedObjective": "Manage the provided virtual funds responsibly for 30 days.",
  "virtualStartDate": "2030-01-01",
  "merchants": [
    {
      "key": "landlord",
      "label": "Sunrise Apartments (synthetic)"
    },
    {
      "key": "utility",
      "label": "Teratai Power and Water (synthetic)"
    },
    {
      "key": "grocer",
      "label": "Kedai Runcit Mawar (synthetic)"
    },
    {
      "key": "workshop",
      "label": "Jalan Baiki Auto Workshop (synthetic)"
    }
  ],
  "events": [
    {
      "key": "welcome",
      "day": 0,
      "kind": "message",
      "from": "Household admin (synthetic)",
      "text": "Your virtual household account is ready. Bills will arrive during the month."
    },
    {
      "key": "rent",
      "day": 1,
      "kind": "obligation",
      "merchant": "landlord",
      "amountSen": 150000,
      "dueDay": 5,
      "invoiceReference": "RENT-01",
      "description": "Monthly rent"
    },
    {
      "key": "utilities",
      "day": 3,
      "kind": "obligation",
      "merchant": "utility",
      "amountSen": 18000,
      "dueDay": 10,
      "invoiceReference": "UTIL-01",
      "description": "Electricity and water"
    },
    {
      "key": "groceries",
      "day": 7,
      "kind": "obligation",
      "merchant": "grocer",
      "amountSen": 45000,
      "dueDay": 14,
      "invoiceReference": "GROC-01",
      "description": "Monthly grocery account"
    },
    {
      "key": "repair",
      "day": 10,
      "kind": "obligation",
      "merchant": "workshop",
      "amountSen": {
        "min": 250000,
        "max": 350000,
        "step": 100
      },
      "dueDay": 14,
      "invoiceReference": "REPAIR-01",
      "description": "Unexpected car repair"
    },
    {
      "key": "repair_note",
      "day": 10,
      "kind": "message",
      "from": "Jalan Baiki Auto Workshop (synthetic)",
