# Docker Compose and the database owner role only. Never loaded by the API or the worker (ADR-0013 A3).
POSTGRES_DB=finmind
POSTGRES_USER=finmind
POSTGRES_PASSWORD=replace-with-local-development-secret
POSTGRES_PORT=5432
# Compose project name. A second copy of FINMIND on the same machine needs its own name and port.
COMPOSE_PROJECT_NAME=finmind
